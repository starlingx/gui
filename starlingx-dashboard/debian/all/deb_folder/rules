#!/usr/bin/make -f
export DH_VERBOSE = 1

export PBR_VERSION=1.0
export PYBUILD_NAME=starlingx-dashboard
export ROOT=debian/tmp
export DATA_DIR=$(ROOT)/usr/lib/python3/dist-packages
export OS_DIR=$(DATA_DIR)/openstack_dashboard

export ENABLED_DIR=$(OS_DIR)/enabled
export STX_THEMES_DIR=$(ROOT)/usr/share/openstack-dashboard/themes/starlingx
export BASIC_THEMES_DIR=$(ROOT)/usr/share/openstack-dashboard/themes/basic
export LOCAL_SETTINGS_DIR=$(ROOT)/etc/openstack-dashboard/local_settings.d
export STX_TEMPLATES_DIR=$(OS_DIR)/starlingx_templates
export OVERRIDES_DIR=$(OS_DIR)/overrides
export LOGS_DIR=$(ROOT)/var/log/horizon

# starlingx_dashboard app catalog install location (where Django resolves the
# installed app's catalogs: <app_package_dir>/locale/<locale>/LC_MESSAGES/<domain>.mo)
export APP_DIR=$(DATA_DIR)/starlingx_dashboard
export LOCALE_DIR=$(APP_DIR)/locale
export LC_DIR=$(LOCALE_DIR)/zh_Hans/LC_MESSAGES

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_install:
	python3 setup.py install --install-layout=deb --root $(ROOT)

	# Compile the starlingx_dashboard gettext catalogs (domains django and
	# djangojs, locale zh_Hans) into the installed app tree so the .mo ship in
	# the .deb (air-gapped: no gettext/Babel on the controller). msgfmt --check
	# validates each catalog and the build fails loudly, naming the failing
	# domain; no error is masked (no || true).
	set -e; \
	for d in django djangojs; do \
		src=starlingx_dashboard/locale/zh_Hans/LC_MESSAGES/$$d.po; \
		if [ ! -f "$$src" ]; then \
			echo "ERROR: missing zh_Hans catalog for domain '$$d': $$src" >&2; exit 1; \
		fi; \
		if ! grep -q '^"Plural-Forms: nplurals=1; plural=0;' "$$src"; then \
			echo "ERROR: domain '$$d' zh_Hans Plural-Forms header is not 'nplurals=1; plural=0;' in $$src" >&2; exit 1; \
		fi; \
		install -d -m 755 $(LC_DIR); \
		if ! msgfmt --check -o $(LC_DIR)/$$d.mo "$$src"; then \
			echo "ERROR: msgfmt --check failed for domain '$$d' (catalog $$src)" >&2; exit 1; \
		fi; \
	done

	python3 setup.py bdist_wheel \
		--universal \
		-d $(CURDIR)/debian/starlingx-dashboard-wheels/usr/share/python3-wheels

	install -d -m 755 $(ENABLED_DIR)
	install -p -D -m 755 starlingx_dashboard/enabled/* $(ENABLED_DIR)

	install -d -m 755 $(STX_THEMES_DIR)
	cp -R starlingx_dashboard/themes/starlingx/* $(STX_THEMES_DIR)
	chmod -R 755 $(STX_THEMES_DIR)/*

	install -d -m 755 $(BASIC_THEMES_DIR)
	cp -R starlingx_dashboard/themes/basic/* $(BASIC_THEMES_DIR)
	chmod -R 755 $(BASIC_THEMES_DIR)/*

	install -d -m 755 $(LOCAL_SETTINGS_DIR)
	install -p -D -m 755 starlingx_dashboard/local/local_settings.d/* $(LOCAL_SETTINGS_DIR)

	install -d -m 755 $(STX_TEMPLATES_DIR)
	cp -R starlingx_dashboard/starlingx_templates/* $(STX_TEMPLATES_DIR)
	chmod -R 755 $(STX_TEMPLATES_DIR)/*

	install -d -m 755 $(OVERRIDES_DIR)
	install -p -D -m 755 starlingx_dashboard/overrides/* $(OVERRIDES_DIR)

	install -d -m 755 $(LOGS_DIR)

	dh_install

override_dh_auto_test:
	echo "do nothing"